# Plantilla de variables de entorno para kult-backend
SPRING_PROFILES_ACTIVE=dev

# Desarrollo local (dev)
MYSQLDATABASE=kult
MYSQLHOST=localhost
MYSQLPASSWORD=Admin12345
MYSQLPORT=3306
MYSQLUSER=root

# Producción en Render + Railway MySQL (Caso A - Public Network):
# Opción 1 (recomendada): pegar el valor RESUELTO de MYSQL_PUBLIC_URL desde Railway
# MYSQL_PUBLIC_URL=mysql://root:TU_PASSWORD@TU_HOST.proxy.rlwy.net:TU_PUERTO/railway
#
# Opción 2: variables individuales de Railway (Public TCP Proxy)
# RAILWAY_TCP_PROXY_DOMAIN=TU_HOST.proxy.rlwy.net
# RAILWAY_TCP_PROXY_PORT=TU_PUERTO
